# Telegram bot token — used to verify initData signatures.
# Get it from @BotFather.
TELEGRAM_BOT_TOKEN=

# Tribute signs webhook bodies with your API key, so this must be the API
# key itself (Tribute app -> API Key), not a secret you invent.
TRIBUTE_WEBHOOK_SECRET=

# Same API key, used to look a subscriber up when KV has no record of them —
# e.g. they paid before the webhook was set up. Optional: the /subscribers
# endpoint is not open to every key, and the lookup is skipped without it.
TRIBUTE_API_KEY=

# Guards /api/admin-grant, for handing out access by hand. Any random
# string; keep it secret.
ADMIN_SECRET=

# Where the /start button sends people — the deployed Mini App.
MINI_APP_URL=https://p3m-alpha.vercel.app/

# Any random string, passed to setWebhook as secret_token so only Telegram
# can post to /api/telegram-webhook.
TELEGRAM_WEBHOOK_SECRET=

# Provided automatically when you add Vercel KV (Upstash) to the project.
KV_REST_API_URL=
KV_REST_API_TOKEN=
