# Telegram bot token — used to verify initData signatures.
# Get it from @BotFather.
TELEGRAM_BOT_TOKEN=

# Shared secret for the Tribute webhook. Set the same value in Tribute's
# dashboard so forged calls are rejected.
TRIBUTE_WEBHOOK_SECRET=

# Provided automatically when you add Vercel KV (Upstash) to the project.
KV_REST_API_URL=
KV_REST_API_TOKEN=
